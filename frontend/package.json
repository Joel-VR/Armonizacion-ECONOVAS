{
  "name": "tukri-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "format": "prettier --write src index.html vite.config.ts tests",
    "format:check": "prettier --check src index.html vite.config.ts tests"
  },
  "dependencies": {
    "@lucide/vue": "^1.72.0",
    "@turf/helpers": "^7.4.0",
    "@turf/union": "^7.4.0",
    "echarts": "^6.1.0",
    "maplibre-gl": "^6.18.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-vue": "^5.2.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
